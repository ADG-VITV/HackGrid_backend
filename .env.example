# ---------------------------------------------------------------------------
# HackGrid backend — environment
# Copy to .env for local development. On Render, set these in the dashboard.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Render Postgres, local...).
# Required. Prisma reads it for `prisma db push`; the server reads it at boot.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional. When set AND the server runs in production, it replaces
# DATABASE_URL so a dev run can never touch the live tables by accident.
# DATABASE_URL_PRODUCTION="postgresql://..."

# Port to listen on. Render injects PORT itself — do not set it there.
PORT=4000

# Interface to bind. Defaults to 0.0.0.0 (required on Render).
# HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API and open
# sockets. Unset in development = any origin. REQUIRED in production, e.g.
# CORS_ORIGIN="https://hackgrid.vercel.app,https://hackgrid-git-main-you.vercel.app"
# CORS_ORIGIN=

# Shared secret that unlocks the organiser routes (/api/admin/* mutations and
# /api/auction/{start,reset,capsules/:key/start}) in production. Leave unset
# to keep them closed. Set the same value as ADMIN_API_KEY on the frontend.
# ADMIN_API_KEY=

# Explicit mode. Normally inferred: `npm run dev` = development, anything
# else = production. Set NODE_ENV=production on Render.
# NODE_ENV=production

# --- Judge portal (/api/judge) ---------------------------------------------
# Firebase project id, so the server can verify the Google sign-in ID tokens
# the frontend forwards for judges. The same value as the frontend's
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. No service account is needed. Unset =
# the judge routes answer 503.
# FIREBASE_PROJECT_ID=hackgrid-26

# The shared code a judge types to apply (and again to open the evaluations).
# Read by `npm run db:seed`, which stores only its SHA-256. Required, >= 8
# characters, no default. Case and spaces are ignored.
# HACKGRID_JUDGE_INVITE_CODE=

# Auction timings (seconds). Override for a fast dry run; defaults shown.
# A main-pod tier stays open this long with nobody bidding (5 min); bidding
# never runs past it.
# HACKGRID_TIER_SECONDS=300
# HACKGRID_BID_TIMEOUT_SECONDS=13
# The same window for a remainder (lucky) pod's tiers (3 min).
# HACKGRID_REMAINDER_SECONDS=180
